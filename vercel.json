      "destination": "/landing",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.algolabmty.com" }],
      "destination": "/landing",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/whats",
      "has": [{ "type": "host", "value": "algolabmty.com" }],
      "destination": "/whats"
    },
    {
      "source": "/whats",
      "has": [{ "type": "host", "value": "www.algolabmty.com" }],
      "destination": "/whats"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "algolabmty.com" }],
      "destination": "/landing"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.algolabmty.com" }],
      "destination": "/landing"
    }
  ]
